# =============================================================================
# Variables de entorno de PiShop Cloud.
#
#   1) Copie este archivo:      copy .env.example .env      (Windows cmd)
#                               cp .env.example .env        (Linux / Mac)
#   2) O genere uno con claves aleatorias fuertes (recomendado):
#                               python scripts/generar_env.py
#
# El archivo .env NUNCA se sube a Git (está en .gitignore).
# =============================================================================

# --- PostgreSQL 17 -----------------------------------------------------------
# Superusuario: solo lo usa el script que crea las 6 bases y sus usuarios.
POSTGRES_PASSWORD=cambiar-esto-superusuario

# Una contraseña por base de datos. Cada servicio conoce SOLO la suya.
PG_CLAVE_CATALOGO=cambiar-esto-catalogo
PG_CLAVE_INVENTARIO=cambiar-esto-inventario
PG_CLAVE_PEDIDOS=cambiar-esto-pedidos
PG_CLAVE_PAGOS=cambiar-esto-pagos
PG_CLAVE_NOTIF=cambiar-esto-notif
PG_CLAVE_REPORTES=cambiar-esto-reportes

# --- API pública -------------------------------------------------------------
# Clave que deben enviar los clientes en la cabecera X-API-Key.
PISHOP_API_KEY=cambiar-esto-clave-api-publica
# Límite de peticiones por clave (requisito del proyecto: máximo 40 por minuto).
PISHOP_RATE_LIMIT=40/minute

# --- Entorno -----------------------------------------------------------------
# dev | qa | stg | prod   (fuera de dev la API exige una clave de 16+ caracteres)
PISHOP_APP_ENV=dev

# --- Puertos del computador anfitrión (cámbielos si ya están ocupados) ---------
PUERTO_POSTGRES_HOST=5433
PUERTO_REDIS_HOST=6380

# --- Opcional: protege los cambios del config-service (cabecera X-Token-Admin) ---
PISHOP_CONFIG_ADMIN_TOKEN=
