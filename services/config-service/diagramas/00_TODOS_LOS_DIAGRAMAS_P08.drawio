  <diagram id="05-clases-y-mer" name="05 Clases y MER">
    <mxGraphModel dx="1280" dy="860" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="titulo" value="Diagrama UML de Clases y Modelo Entidad-Relación (MER) — P08 config-service
Autor: Francisco Navarro · Separación de Esquema HTTP (Pydantic), Dominio/Almacén (SQLite) y Cliente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a365d;fontColor=#ffffff;strokeColor=#0f172a;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1180" height="50" as="geometry"/></mxCell>
        <mxCell id="c_set" value="&lt;&lt;BaseSettings&gt;&gt;
Settings (app/settings.py)
────────────────────────────────────
+ service_name: str = 'config-service'
+ http_port: int = 8010
+ app_env: str = 'dev'
+ database_url: str
+ seed_path: str = ''
+ write_token: SecretStr
+ http_timeout_seconds: float = 2.0
────────────────────────────────────
+ get_settings() -&gt; Settings {frozen=True}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontFamily=Courier New;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="45" y="100" width="340" height="215" as="geometry"/></mxCell>
        <mxCell id="c_pub" value="&lt;&lt;Pydantic Schema (ACL HTTP)&gt;&gt;
Publicacion (app/main.py)
────────────────────────────────────
+ data: dict[str, Valor]
+ motivo: str = 'actualización...' (3..256)
────────────────────────────────────
+ _validar_escritura(x_autor, token) -&gt; str
+ _etag_para(version: int) -&gt; str" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="45" y="355" width="340" height="165" as="geometry"/></mxCell>
        <mxCell id="c_repo" value="&lt;&lt;Repository&gt;&gt;
Repositorio (app/store.py)
────────────────────────────────────
- ruta: str
- _conn: sqlite3.Connection
- _lock: threading.RLock
────────────────────────────────────
+ crear_esquema() -&gt; None
+ ping() -&gt; bool
+ actual(app, env) -&gt; VersionConfig | None
+ obtener(app, env, v) -&gt; VersionConfig | None
+ historial(app, env) -&gt; list[VersionConfig]
+ publicar(app, env, data, autor, motivo) -&gt; VersionConfig
+ cuenta() -&gt; int
+ cerrar() -&gt; None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="100" width="380" height="245" as="geometry"/></mxCell>
        <mxCell id="c_ent" value="&lt;&lt;Dataclass Frozen&gt;&gt;
VersionConfig (app/store.py)
────────────────────────────────────
+ id: int
+ app: str
+ env: str
+ version: int
+ data_json: str
+ autor: str
+ motivo: str
+ creado_en: str (ISO-8601 UTC)
────────────────────────────────────
+ a_dict(con_data: bool = True) -&gt; dict" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="385" width="380" height="235" as="geometry"/></mxCell>
        <mxCell id="c_cli" value="&lt;&lt;Reusable Client&gt;&gt;
ConfigClient (app/config_client.py)
────────────────────────────────────
+ base_url: str
+ service_name: str
+ app_env: str
+ defaults: dict[str, Any]
+ poll_seconds: float = 15.0
+ timeout_seconds: float = 2.0
+ version: int = 0
+ etag: str | None
+ data: dict[str, Any]
────────────────────────────────────
+ obtener(clave, defecto) -&gt; Any
+ refrescar() -&gt; bool
+ iniciar() -&gt; None
+ detener() -&gt; None" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontFamily=Courier New;fontSize=11;" vertex="1" parent="1"><mxGeometry x="875" y="100" width="355" height="280" as="geometry"/></mxCell>
        <mxCell id="mer_tbl" value="&lt;&lt;Tabla SQLite — MER&gt;&gt;
config_versiones (Base propia P08)
════════════════════════════════════
PK  id          INTEGER AUTOINCREMENT
UK1 app         TEXT NOT NULL (index)
UK1 env         TEXT NOT NULL (index)
UK1 version     INTEGER NOT NULL
    data_json   TEXT NOT NULL (JSON)
    autor       TEXT NOT NULL (X-Autor)
    motivo      TEXT NOT NULL
    creado_en   TEXT NOT NULL (UTC)
────────────────────────────────────
UNIQUE (app, env, version)
INDEX ix_config_app_env (app, env, version)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontFamily=Courier New;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="875" y="420" width="355" height="230" as="geometry"/></mxCell>
        <mxCell id="rel1" value="configura" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="c_set" target="c_repo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel2" value="valida entrada PUT" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="c_pub" target="c_repo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel3" value="1..* instancia" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="c_repo" target="c_ent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel4" value="persiste en (1 a N versiones)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="c_ent" target="mer_tbl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel5" value="consume vía HTTP + ETag" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="c_cli" target="c_repo"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
