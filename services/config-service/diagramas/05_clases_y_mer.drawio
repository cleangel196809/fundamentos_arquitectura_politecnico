        <mxCell id="mer_tbl" value="&lt;&lt;Tabla SQLite — MER&gt;&gt;
config_versiones (Base propia P08)
════════════════════════════════════
PK  id          INTEGER AUTOINCREMENT
UK1 app         TEXT NOT NULL (index)
UK1 env         TEXT NOT NULL (index)
UK1 version     INTEGER NOT NULL
    data_json   TEXT NOT NULL (JSON)
    autor       TEXT NOT NULL (X-Autor)
    motivo      TEXT NOT NULL
    creado_en   TEXT NOT NULL (UTC)
────────────────────────────────────
UNIQUE (app, env, version)
INDEX ix_config_app_env (app, env, version)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontFamily=Courier New;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="875" y="420" width="355" height="230" as="geometry"/></mxCell>
